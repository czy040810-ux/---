<view class="page">
  <view class="brand">我的错题本</view><view class="sub">按知识点整理，按照遗忘规律复习。</view>
  <view class="card row"><view>只看今日待复习</view><switch color="#11739f" checked="{{dueOnly}}" bindchange="toggleDue" /></view>
  <scroll-view scroll-x style="white-space:nowrap;margin-top:25rpx">
    <view wx:for="{{tags}}" wx:key="*this" class="chip" data-tag="{{item}}" bindtap="pickTag" style="margin-right:14rpx;background:{{active===item?'#11739f':'#eaf5fb'}};color:{{active===item?'#fff':'#116f99'}}">{{item}}</view>
  </scroll-view>
  <view wx:if="{{shown.length===0}}" class="card muted">暂无符合条件的错题，试着拍照添加第一道。</view>
  <view wx:for="{{shown}}" wx:key="id" class="card" bindtap="detail" data-id="{{item.id}}">
    <view class="row"><view class="chip">{{item.tag}}</view><view class="muted small">{{item.dueLabel}} 复习</view></view>
    <view class="question" style="margin-top:15rpx">{{item.short}}</view>
    <view class="row" style="margin-top:15rpx"><view class="muted small">{{item.isDue?'今天可以复习':'已安排下次复习'}}</view><view class="muted small">查看详情 ›</view></view>
  </view>
</view>
