<view class="page">
  <view class="brand">共建题库</view><view class="sub">同学整理 · 审核后共享 · 尊重原创</view>
  <scroll-view scroll-x style="white-space:nowrap;margin-top:25rpx">
    <view wx:for="{{tags}}" wx:key="*this" class="chip" data-tag="{{item}}" bindtap="pick" style="margin-right:14rpx;background:{{active===item?'#11739f':'#eaf5fb'}};color:{{active===item?'#fff':'#116f99'}}">{{item}}</view>
  </scroll-view>
  <view wx:if="{{shown.length===0}}" class="card muted">当前暂无已审核通过的公开题目。</view>
  <view wx:for="{{shown}}" wx:key="id" class="card">
    <view class="chip">{{item.tag}}</view><view class="question" style="margin-top:14rpx">{{item.text}}</view>
    <button class="button ghost" data-id="{{item.id}}" bindtap="toggle">{{opened===item.id?'收起解析':'查看解析与变式题'}}</button>
    <view wx:if="{{opened===item.id}}"><view class="divider"></view>
      <view class="muted">解析</view><view class="question">{{item.explanation}}</view>
      <view class="muted">变式题</view><view class="question">{{item.variant}}</view>
      <view class="muted">参考答案</view><view class="question">{{item.answer}}</view>
    </view>
  </view>
</view>
